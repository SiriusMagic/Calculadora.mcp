<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Exchange rates (one fixed address, see data/RatesSource.kt) and Modo MCP through the relay, when turned on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Floating window over other apps, kept alive by a foreground service while it is open. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Redireccionar a Hub»: only apps signed with the same key (Gateway Hub) get this permission. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/hub_link_permission" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="stateAlwaysHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gateway Hub's scanner finds the calculator (module calc_) and its link channel. Being found turns nothing on. -->
            <intent-filter>
                <action android:name="com.zirakusa.gatewayhub.action.APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.zirakusa.gatewayhub.module" android:value="calc_" />
            <meta-data android:name="com.zirakusa.gatewayhub.link" android:value="${applicationId}.hublink" />
        </activity>
        <provider android:name=".mcp.HubLinkProvider" android:authorities="${applicationId}.hublink"
            android:exported="true" android:permission="com.zirakusa.gatewayhub.permission.LINK" />
        <service android:name=".floating.FloatingService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating calculator window shown over other apps while the user keeps it open" />
        </service>
    </application>
</manifest>
